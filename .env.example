# PayGate-Omni 环境变量示例
# 使用方法：cp .env.example .env，然后修改所有标注为 CHANGE_ME 的值

APP_ENV=development

DB_USER=paygate
DB_PASSWORD=CHANGE_ME_strong_password_here
DB_NAME=paygate_omni

REDIS_PASSWORD=

# MASTER_KEY 必须是恰好 32 字节的 ASCII 字符串
# 生成命令：openssl rand -hex 16 | head -c 32
# 警告：数据库有数据后严禁更换，否则加密数据永久无法解密！
ADMIN_PASSWORD=admin123456
MASTER_KEY=CHANGE_ME_exactly_32bytes_key!!
